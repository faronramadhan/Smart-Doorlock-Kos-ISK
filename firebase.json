{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "Website",
    "ignore": [
      "Website/Firmware/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
